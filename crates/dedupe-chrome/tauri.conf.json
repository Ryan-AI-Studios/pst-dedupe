{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Dedupe Desk",
  "version": "0.2.0-rc.1",
  "identifier": "com.dedupe.desk.chrome",
  "build": {
    "beforeDevCommand": "trunk serve --config ui/Trunk.toml",
    "beforeBuildCommand": "trunk build --release --config ui/Trunk.toml",
    "devUrl": "http://localhost:1420",
    "frontendDist": "ui/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Dedupe Desk",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self' 'wasm-unsafe-eval'",
        "connect-src": "'self' ipc: http://ipc.localhost",
        "font-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data:"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
