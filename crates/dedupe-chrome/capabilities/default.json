{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window: dialog picker + matter chrome commands (no blanket fs)",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:default",
    "allow-matter-overview",
    "allow-create-matter",
    "allow-recent-matters-list",
    "allow-recent-matters-remember",
    "allow-review-queue-page",
    "allow-review-code-catalog",
    "allow-saved-searches-list",
    "allow-saved-search-upsert",
    "allow-review-codes-preview",
    "allow-review-apply-codes",
    "allow-review-document",
    "allow-review-document-body",
    "allow-review-window-apply",
    "allow-review-upsert-note",
    "allow-review-upsert-privilege",
    "allow-produce-page",
    "allow-produce-qc-run",
    "allow-produce-start"
  ]
}
